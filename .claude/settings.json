{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/secrets/**)",
      "Read(./**/*credential*)",
      "Read(./**/*private*.pem)",
      "Bash(rm -rf *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(docker compose *)",
      "Bash(./gradlew flywayMigrate *)",
      "Bash(mvn flyway:migrate *)"
    ]
  }
}
