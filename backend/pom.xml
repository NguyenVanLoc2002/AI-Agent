<?xml version="1.0" encoding="UTF-8"?>
<!--
  POC-001 Project Bootstrap (EP-00). Modular monolith skeleton only: no business logic,
  no Arito / LLM provider integration, synthetic data only. See docs/architecture/.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.secureerp</groupId>
    <artifactId>secure-erp-agent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>secure-erp-agent</name>
    <description>Secure ERP AI Agent - security-first PoC backend (Mock Arito, synthetic data only)</description>

    <properties>
        <java.version>21</java.version>
        <spring-modulith.version>2.1.2</spring-modulith.version>
        <archunit.version>1.5.1</archunit.version>
        <wiremock.version>3.13.1</wiremock.version>
        <!-- FE-DEPLOY (A-74, review architecture M2): where the built frontend is; override with -Dfrontend.dist=... -->
        <frontend.dist>${project.basedir}/../frontend/dist</frontend.dist>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Runtime -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- EP-04 / ADR-010 (A-06 APPROVED): form login, session cookie, CSRF. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-api</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- SEC-01a / ADR-016: Fake provider and local proxy capture. Standalone jar shades its own
             Jetty/Jackson, so it does not change the application's runtime classpath. Test scope only. -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Unit + architecture tests (no Docker): *Test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- EP-09c reviews (SEC-05): the complete output of every test class goes to a file in the
                         scanned report directory, not only the per-test system-out of the XML report. -->
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Integration tests with Testcontainers (Docker required): *IT -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                    <!-- EP-09c SEC-05 (A-46 3A): scan the surefire/failsafe reports of this build for restricted
                         values, after the tests above passed. Own report directory and summary, so the scan
                         never reads its own output; a fixed test name, so -Dit.test does not change it. -->
                    <execution>
                        <id>sec05-artifact-scan</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                        <configuration>
                            <test>Sec05ArtifactScan</test>
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                            <reportsDirectory>${project.build.directory}/sec05-reports</reportsDirectory>
                            <summaryFile>${project.build.directory}/sec05-reports/failsafe-summary.xml</summaryFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- FE-DEPLOY (A-74, review architecture M1 / security L3): the default build never ships a frontend, also
             after an earlier -Pwith-frontend build without "clean". Deactivated when another profile is given. -->
        <profile>
            <id>no-frontend</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>remove-frontend</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.outputDirectory}/static" quiet="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!-- FE-DEPLOY (A-74, decision 2A): put the built frontend into the jar, served from classpath:/static/.
             Release order: cd ../frontend && npm ci && npm run build, then ./mvnw -Pwith-frontend clean package.
             The build fails when ${frontend.dist}/index.html is missing, or when dist holds anything but index.html
             and assets/ or a source map (review security L2: a later public/ file or .map would be served).
             The previous copy is removed first, so old hashed assets never pile up (review architecture M1). -->
        <profile>
            <id>with-frontend</id>
            <build>
                <plugins>
                    <plugin>
                        <!-- maven-enforcer's requireFilesExist reports a path with ".." as missing (it compares the
                             canonical path), so plain Ant checks are used. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>frontend-dist-checked</id>
                                <phase>validate</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <fail message="Build the frontend first: cd ../frontend &amp;&amp; npm ci &amp;&amp; npm run build">
                                            <condition>
                                                <not>
                                                    <available file="${frontend.dist}/index.html"/>
                                                </not>
                                            </condition>
                                        </fail>
                                        <fail message="frontend/dist holds a source map or a file outside index.html and assets/: not shipped (ADR-015)">
                                            <condition>
                                                <resourcecount when="greater" count="0">
                                                    <fileset dir="${frontend.dist}">
                                                        <include name="**/*"/>
                                                        <exclude name="index.html"/>
                                                        <exclude name="assets/*.js"/>
                                                        <exclude name="assets/*.css"/>
                                                        <exclude name="assets/*.woff2"/>
                                                    </fileset>
                                                </resourcecount>
                                            </condition>
                                        </fail>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>remove-previous-frontend</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <delete dir="${project.build.outputDirectory}/static" quiet="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-frontend-dist</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${frontend.dist}</directory>
                                            <filtering>false</filtering>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
